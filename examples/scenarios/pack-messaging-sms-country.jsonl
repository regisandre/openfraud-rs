# A code asked for a number from another country than the request: the
# usual shape of SMS pumping, where a script asks codes for premium numbers
# abroad. Countries that share a calling code (the US and Canada, +1) are
# not told apart. Without a request country, nothing is judged.
# packs: messaging
# enforce
{"event": {"id": "sc-1", "type": "message.otp_requested", "at": "2026-10-19T09:00:00Z", "ip": "198.18.30.1", "country": "BE", "phone": "+32470123456"}, "expect": {"decision": "allow", "not_rules": ["sms_country_mismatch"]}}
{"event": {"id": "sc-2", "type": "message.otp_requested", "at": "2026-10-19T09:01:00Z", "ip": "198.18.30.2", "country": "BE", "phone": "+2250712345678"}, "expect": {"rules": ["sms_country_mismatch"]}}
{"event": {"id": "sc-3", "type": "message.otp_requested", "at": "2026-10-19T09:02:00Z", "ip": "198.18.30.3", "country": "CA", "phone": "+14165550100"}, "expect": {"not_rules": ["sms_country_mismatch"]}}
{"event": {"id": "sc-4", "type": "message.otp_requested", "at": "2026-10-19T09:03:00Z", "ip": "198.18.30.4", "phone": "+2250712345679"}, "expect": {"not_rules": ["sms_country_mismatch"]}}
