# SMS pumping, with the messaging pack acting. The operator only sends to +32
# and +33. One address requests 21 codes in an hour for numbers of one
# range (the 10th trips the range limit, the 21st the address limit). A
# request for a number in a country the operator does not serve is caught on
# its own. A list of consecutive phone numbers is caught by its shape. A
# customer asking for her own code is allowed.
# packs: messaging
# enforce
# list: sms_allowed_prefixes +32
# list: sms_allowed_prefixes +33
{"event": {"id": "ngsms-1", "type": "message.otp_requested", "at": "2026-10-19T01:00:00Z", "ip": "198.18.20.1", "phone": "+84901234567"}, "expect": {"decision": "hold", "rules": ["sms_country_not_allowed"]}}
{"event": {"id": "ngsms-2", "type": "message.send_requested", "at": "2026-10-19T01:10:00Z", "actor_id": "gen_1", "ip": "198.18.21.1", "country": "BE", "attrs": {"channel": "sms", "recipients": ["+32470200101", "+32470200102", "+32470200103", "+32470200104", "+32470200105"]}}, "expect": {"decision": "hold", "rules": ["sms_sequential_numbers"], "not_rules": ["sms_country_not_allowed"]}}
{"event": {"id": "ngsms-3", "type": "message.otp_requested", "at": "2026-10-19T01:20:00Z", "actor_id": "legit_1", "ip": "203.0.113.5", "phone": "+32475123456", "country": "BE"}, "expect": {"decision": "allow", "not_rules": ["sms_country_not_allowed", "sms_prefix_flood", "sms_ip_flood", "sms_sequential_numbers"]}}
