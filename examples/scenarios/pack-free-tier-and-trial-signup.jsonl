# A sign-up farm and its cousins, with the free-tier-and-trial pack acting.
# One person registers accounts from one address and one device, with throwaway
# mailboxes and a brand name as username. The third account on the device and
# the fourth on the address are caught, the fourth is quarantined, and every
# later account that reuses its device, mailbox or cluster is flagged at
# sign-up. A second address registers eleven accounts over a day (below the
# per-hour limit but over the daily one). A normal customer signs up on
# her own and stays allowed.
# packs: free-tier-and-trial
# enforce
# list: disposable_domains tempmail.example
{"event": {"id": "su-1", "type": "account.created", "at": "2026-10-19T08:00:00Z", "actor_id": "farm_1", "email": "farm1@example.org", "ip": "198.51.100.10", "device": "dev_farm", "country": "BE"}, "expect": {"decision": "allow", "not_rules": ["signup_disposable_email"]}}
{"event": {"id": "su-2", "type": "account.created", "at": "2026-10-19T08:05:00Z", "actor_id": "farm_2", "email": "farm2@example.org", "ip": "198.51.100.10", "device": "dev_farm", "country": "BE"}, "expect": {"decision": "allow", "not_rules": ["signup_device_reuse", "signup_ip_burst"]}}
{"event": {"id": "su-3", "type": "account.created", "at": "2026-10-19T08:10:00Z", "actor_id": "farm_3", "email": "farm3@example.org", "ip": "198.51.100.10", "device": "dev_farm", "country": "BE"}, "expect": {"decision": "review", "rules": ["signup_device_reuse"], "not_rules": ["signup_ip_burst"]}}
{"event": {"id": "su-4", "type": "account.created", "at": "2026-10-19T08:15:00Z", "actor_id": "farm_4", "email": "farm4@tempmail.example", "ip": "198.51.100.10", "device": "dev_farm", "country": "BE", "attrs": {"username": "paypal-support-4"}}, "expect": {"decision": "quarantine", "status": "quarantined", "rules": ["signup_ip_burst", "signup_device_reuse", "signup_disposable_email", "signup_brand_name"]}}
# The same device on a new address: flagged device, flagged cluster.
{"event": {"id": "su-5", "type": "account.created", "at": "2026-10-19T09:00:00Z", "actor_id": "farm_5", "email": "farm5@example.org", "ip": "198.51.100.11", "device": "dev_farm", "country": "BE"}, "expect": {"rules": ["signup_flagged_device", "signup_flagged_cluster"]}}
# The mailbox of the quarantined account, on a clean device and address.
{"event": {"id": "su-6", "type": "account.created", "at": "2026-10-19T09:30:00Z", "actor_id": "farm_6", "email": "farm4@tempmail.example", "ip": "198.51.100.12", "device": "dev_other", "country": "BE"}, "expect": {"decision": "quarantine", "rules": ["signup_flagged_mailbox", "signup_flagged_cluster"]}}
# Eleven accounts from one address over twenty hours: the daily limit.
{"event": {"id": "sd-1", "type": "account.created", "at": "2026-10-20T00:00:00Z", "actor_id": "slow_1", "email": "slow1@example.com", "ip": "198.51.100.20", "device": "dev_s1", "country": "NL"}, "expect": {"decision": "allow"}}
{"event": {"id": "sd-2", "type": "account.created", "at": "2026-10-20T02:00:00Z", "actor_id": "slow_2", "email": "slow2@example.com", "ip": "198.51.100.20", "device": "dev_s2", "country": "NL"}, "expect": {"decision": "allow"}}
{"event": {"id": "sd-3", "type": "account.created", "at": "2026-10-20T04:00:00Z", "actor_id": "slow_3", "email": "slow3@example.com", "ip": "198.51.100.20", "device": "dev_s3", "country": "NL"}, "expect": {"decision": "allow"}}
{"event": {"id": "sd-4", "type": "account.created", "at": "2026-10-20T06:00:00Z", "actor_id": "slow_4", "email": "slow4@example.com", "ip": "198.51.100.20", "device": "dev_s4", "country": "NL"}, "expect": {"decision": "allow"}}
{"event": {"id": "sd-5", "type": "account.created", "at": "2026-10-20T08:00:00Z", "actor_id": "slow_5", "email": "slow5@example.com", "ip": "198.51.100.20", "device": "dev_s5", "country": "NL"}, "expect": {"decision": "allow"}}
{"event": {"id": "sd-6", "type": "account.created", "at": "2026-10-20T10:00:00Z", "actor_id": "slow_6", "email": "slow6@example.com", "ip": "198.51.100.20", "device": "dev_s6", "country": "NL"}, "expect": {"decision": "allow"}}
{"event": {"id": "sd-7", "type": "account.created", "at": "2026-10-20T12:00:00Z", "actor_id": "slow_7", "email": "slow7@example.com", "ip": "198.51.100.20", "device": "dev_s7", "country": "NL"}, "expect": {"decision": "allow"}}
{"event": {"id": "sd-8", "type": "account.created", "at": "2026-10-20T14:00:00Z", "actor_id": "slow_8", "email": "slow8@example.com", "ip": "198.51.100.20", "device": "dev_s8", "country": "NL"}, "expect": {"decision": "allow"}}
{"event": {"id": "sd-9", "type": "account.created", "at": "2026-10-20T16:00:00Z", "actor_id": "slow_9", "email": "slow9@example.com", "ip": "198.51.100.20", "device": "dev_s9", "country": "NL"}, "expect": {"decision": "allow"}}
{"event": {"id": "sd-10", "type": "account.created", "at": "2026-10-20T18:00:00Z", "actor_id": "slow_10", "email": "slow10@example.com", "ip": "198.51.100.20", "device": "dev_s10", "country": "NL"}, "expect": {"decision": "allow", "not_rules": ["signup_ip_day"]}}
{"event": {"id": "sd-11", "type": "account.created", "at": "2026-10-20T20:00:00Z", "actor_id": "slow_11", "email": "slow11@example.com", "ip": "198.51.100.20", "device": "dev_s11", "country": "NL"}, "expect": {"decision": "allow", "rules": ["signup_ip_day"], "not_rules": ["signup_ip_burst"]}}
# Control: a customer signing up alone.
{"event": {"id": "ok-1", "type": "account.created", "at": "2026-10-20T21:00:00Z", "actor_id": "legit_1", "email": "alice@example.com", "ip": "203.0.113.5", "device": "dev_alice", "country": "BE", "attrs": {"username": "alice"}}, "expect": {"decision": "allow", "status": "normal", "not_rules": ["signup_ip_burst", "signup_ip_day", "signup_device_reuse", "signup_disposable_email", "signup_flagged_mailbox", "signup_flagged_device", "signup_flagged_cluster", "signup_brand_name"]}}
