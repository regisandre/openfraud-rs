{"event": {"id": "promo-15", "type": "account.referred", "at": "2026-10-21T08:20:00Z", "actor_id": "bn_4", "ip": "198.18.104.1", "attrs": {"referrer_id": "boss_1"}}, "expect": {"not_rules": ["referral_burst"]}}
{"event": {"id": "promo-16", "type": "account.referred", "at": "2026-10-21T08:25:00Z", "actor_id": "bn_5", "ip": "198.18.105.1", "attrs": {"referrer_id": "boss_1"}}, "expect": {"not_rules": ["referral_burst"]}}
{"event": {"id": "promo-17", "type": "account.referred", "at": "2026-10-21T08:30:00Z", "actor_id": "bn_6", "ip": "198.18.106.1", "attrs": {"referrer_id": "boss_1"}}, "expect": {"not_rules": ["referral_burst"]}}
{"event": {"id": "promo-18", "type": "account.referred", "at": "2026-10-21T08:35:00Z", "actor_id": "bn_7", "ip": "198.18.107.1", "attrs": {"referrer_id": "boss_1"}}, "expect": {"not_rules": ["referral_burst"]}}
{"event": {"id": "promo-19", "type": "account.referred", "at": "2026-10-21T08:40:00Z", "actor_id": "bn_8", "ip": "198.18.108.1", "attrs": {"referrer_id": "boss_1"}}, "expect": {"not_rules": ["referral_burst"]}}
{"event": {"id": "promo-20", "type": "account.referred", "at": "2026-10-21T08:45:00Z", "actor_id": "bn_9", "ip": "198.18.109.1", "attrs": {"referrer_id": "boss_1"}}, "expect": {"not_rules": ["referral_burst"]}}
{"event": {"id": "promo-21", "type": "account.referred", "at": "2026-10-21T08:50:00Z", "actor_id": "bn_10", "ip": "198.18.110.1", "attrs": {"referrer_id": "boss_1"}}, "expect": {"not_rules": ["referral_burst"]}}
{"event": {"id": "promo-22", "type": "account.referred", "at": "2026-10-21T08:55:00Z", "actor_id": "bn_11", "ip": "198.18.111.1", "attrs": {"referrer_id": "boss_1"}}, "expect": {"decision": "allow", "rules": ["referral_burst"]}}
# Control: a friend referral between two unrelated accounts, then a promo.
{"event": {"id": "promo-23", "type": "account.created", "at": "2026-10-22T08:00:00Z", "actor_id": "friend_1", "email": "friend1@example.com", "ip": "203.0.113.8", "device": "dev_f1", "country": "BE"}, "expect": {"decision": "allow"}}
{"event": {"id": "promo-24", "type": "account.created", "at": "2026-10-22T09:00:00Z", "actor_id": "friend_2", "email": "friend2@example.com", "ip": "203.0.114.9", "device": "dev_f2", "country": "BE"}, "expect": {"decision": "allow"}}
{"event": {"id": "promo-25", "type": "account.referred", "at": "2026-10-22T09:01:00Z", "actor_id": "friend_2", "ip": "203.0.114.9", "device": "dev_f2", "country": "BE", "attrs": {"referrer_id": "friend_1"}}, "expect": {"decision": "allow", "not_rules": ["referral_same_cluster", "referral_burst"]}}
